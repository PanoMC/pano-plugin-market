{
  "name": "pano-plugin-market",
  "version": "1.0.0",
  "description": "Flexible plugin that lets you easily list, manage, and sell products on your website.",
  "type": "module",
  "exports": {
    ".": {
      "node": "./server/server.mjs",
      "default": "./client/client.mjs"
    }
  },
  "scripts": {
    "build": "cross-env DEV=false rollup -c",
    "dev": "cross-env DEV=true rollup -c --watch",
    "prepublishOnly": "npm run build",
    "lint:prettier": "prettier -c . --config .prettierrc",
    "format:prettier": "prettier --write . --config .prettierrc"
  },
  "devDependencies": {
    "@panomc/sdk": "1.0.0-dev.57",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "cross-env": "^10.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "rollup": "^4.32.1",
    "rollup-plugin-delete": "^2.1.0",
    "rollup-plugin-svelte": "^7.2.2"
  },
  "keywords": [
    "svelte"
  ],
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "chart.js": "^4.5.1"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  }
}
