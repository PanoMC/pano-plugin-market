<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="en"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/></head><body style="margin-top:0;margin-bottom:0;margin-right:0;margin-left:0"><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0">{{preheader}}</div><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="margin-right:auto;margin-left:auto;padding-right:0.5rem;padding-left:0.5rem;font-family:ui-sans-serif,system-ui,sans-serif,&quot;Apple Color Emoji&quot;,&quot;Segoe UI Emoji&quot;,&quot;Segoe UI Symbol&quot;,&quot;Noto Color Emoji&quot;"><table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="max-width:600px;margin-right:auto;margin-left:auto;margin-bottom:40px;margin-top:40px;padding:40px"><tbody><tr style="width:100%"><td>
<table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-bottom:32px;text-align:center"><tbody><tr><td><img alt="{{websiteName}}" height="80" src="{{websiteLogo}}" style="display:block;outline:none;border:none;text-decoration:none;margin-right:auto;margin-left:auto;margin-bottom:0rem;margin-top:0rem;border-radius:0.5rem" width="80"/></td></tr></tbody></table>
<table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-bottom:8px;text-align:center"><tbody><tr><td><h1 style="margin:0;padding:0;text-align:center;font-size:28px;font-weight:700;color:rgb(16,24,40)">{{websiteName}}</h1></td></tr></tbody></table>
{{#if testMode}}<table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-top:16px;border-radius:0.5rem;background-color:rgb(254,243,199);padding:8px"><tbody><tr><td><p style="font-size:13px;line-height:20px;margin:0;text-align:center;font-weight:600;color:rgb(146,64,14)">{{testModeLabel}}</p></td></tr></tbody></table>{{/if}}
<table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-bottom:16px;margin-top:24px;text-align:center"><tbody><tr><td><h1 style="margin:0;padding:0;text-align:center;font-size:24px;font-weight:600;color:rgb(30,41,57)">{{heading}}</h1></td></tr></tbody></table>
{{#each paragraphs}}<p style="font-size:16px;line-height:24px;color:rgb(54,65,83);margin-top:16px;margin-bottom:16px">{{this}}</p>{{/each}}
{{#if quote}}<table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-top:16px;margin-bottom:16px;border-left-style:solid;border-left-width:4px;border-color:rgb(209,213,219);padding-left:16px"><tbody><tr><td><p style="font-size:15px;line-height:22px;margin:0;font-style:italic;color:rgb(75,85,99)">{{quote}}</p></td></tr></tbody></table>{{/if}}
{{#if items}}<table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-top:24px;margin-bottom:8px;border-top-style:solid;border-top-width:1px;border-color:rgb(229,231,235)"><tbody>{{#each items}}<tr><td style="padding-top:10px;padding-bottom:10px;border-bottom-style:solid;border-bottom-width:1px;border-color:rgb(243,244,246);font-size:14px;line-height:20px;color:rgb(54,65,83){{#if child}};padding-left:20px{{/if}}">{{quantity}} &times; {{name}}{{#if variant}} <span style="color:rgb(106,114,130)">({{variant}})</span>{{/if}}</td><td align="right" style="padding-top:10px;padding-bottom:10px;border-bottom-style:solid;border-bottom-width:1px;border-color:rgb(243,244,246);font-size:14px;line-height:20px;color:rgb(54,65,83);white-space:nowrap">{{total}}</td></tr>{{/each}}</tbody></table>{{/if}}
{{#if totals}}<table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-bottom:16px"><tbody>{{#each totals}}<tr><td style="padding-top:4px;padding-bottom:4px;font-size:14px;line-height:20px;color:rgb(54,65,83){{#if strong}};font-weight:700;font-size:16px{{/if}}">{{label}}</td><td align="right" style="padding-top:4px;padding-bottom:4px;font-size:14px;line-height:20px;color:rgb(54,65,83);white-space:nowrap{{#if strong}};font-weight:700;font-size:16px{{/if}}">{{value}}</td></tr>{{/each}}</tbody></table>{{/if}}
{{#if details}}<table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-top:16px;margin-bottom:16px;border-radius:0.5rem;background-color:rgb(249,250,251);padding:16px"><tbody>{{#each details}}<tr><td style="padding-top:4px;padding-bottom:4px;font-size:13px;line-height:20px;color:rgb(106,114,130)">{{label}}</td><td align="right" style="padding-top:4px;padding-bottom:4px;font-size:13px;line-height:20px;color:rgb(31,41,55)">{{value}}</td></tr>{{/each}}</tbody></table>{{/if}}
{{#if instructionsHtml}}<div style="font-size:15px;line-height:22px;color:rgb(54,65,83);margin-top:16px;margin-bottom:16px">{{{instructionsHtml}}}</div>{{/if}}
{{#if instructionFields}}<table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-top:8px;margin-bottom:16px;border-radius:0.5rem;background-color:rgb(240,253,244);padding:16px"><tbody>{{#each instructionFields}}<tr><td style="padding-top:4px;padding-bottom:4px;font-size:13px;line-height:20px;color:rgb(106,114,130)">{{label}}</td><td align="right" style="padding-top:4px;padding-bottom:4px;font-size:14px;line-height:20px;font-weight:600;color:rgb(31,41,55)">{{value}}</td></tr>{{/each}}</tbody></table>{{/if}}
{{#if buttonUrl}}{{#if buttonLabel}}<table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-bottom:16px;margin-top:24px;text-align:center"><tbody><tr><td><a href="{{buttonUrl}}" style="line-height:100%;text-decoration:none;display:inline-block;max-width:100%;border-radius:0.5rem;background-color:rgb(85,197,90);padding-right:32px;padding-left:32px;padding-bottom:16px;padding-top:16px;text-align:center;font-size:16px;font-weight:600;color:rgb(255,255,255);text-decoration-line:none" target="_blank">{{buttonLabel}}</a></td></tr></tbody></table>{{/if}}{{/if}}
{{#if secondaryUrl}}{{#if secondaryLabel}}<p style="font-size:14px;line-height:20px;margin-top:8px;margin-bottom:16px;text-align:center"><a href="{{secondaryUrl}}" style="color:rgb(54,65,83)" target="_blank">{{secondaryLabel}}</a></p>{{/if}}{{/if}}
<table align="center" width="100%" border="0" cellPadding="0" cellSpacing="0" role="presentation" style="margin-top:40px;border-top-style:solid;border-top-width:1px;border-color:rgb(229,231,235);padding-top:24px"><tbody><tr><td>{{#if footerNote}}<p style="font-size:12px;line-height:18px;text-align:left;color:rgb(106,114,130);margin-top:16px;margin-bottom:8px">{{footerNote}}</p>{{/if}}<p style="font-size:12px;line-height:18px;text-align:left;color:rgb(106,114,130);margin-top:8px;margin-bottom:16px">{{websiteName}} &middot; {{websiteUrl}}</p></td></tr></tbody></table>
</td></tr></tbody></table></td></tr></tbody></table></body></html>
