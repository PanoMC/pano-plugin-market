{
  "permissions": {
    "MANAGE_MARKET": {
      "title": "Управление маркетом",
      "description": "Может управлять категориями, товарами, сравнениями, подарками, скидками, купонами, кодами авторов, заказами и настройками маркета."
    },
    "MANAGE_MARKET_CATALOG": {
      "title": "Управление каталогом маркета",
      "description": "Может управлять категориями, товарами, вариантами, наборами, сравнениями, целями и остатками маркета."
    },
    "VIEW_MARKET_ORDERS": {
      "title": "Просмотр заказов маркета",
      "description": "Может просматривать заказы, доставки, отправления, подписки и платёжные события маркета и экспортировать заказы. Ничего изменять не может."
    },
    "MANAGE_MARKET_ORDERS": {
      "title": "Управление выполнением заказов маркета",
      "description": "Может повторно запускать и отменять доставки, отзывать покупки, управлять отправлениями, повторно отправлять письма о заказах, редактировать заметки к заказам и управлять списком блокировок."
    },
    "MANAGE_MARKET_PAYMENTS": {
      "title": "Управление платежами маркета",
      "description": "Может выполнять всё, что связано с деньгами: возвраты, отметка заказа оплаченным, проверки, споры, ручные заказы, кредиты, выплаты авторам и списания по подпискам."
    },
    "MANAGE_MARKET_DISCOUNTS": {
      "title": "Управление скидками маркета",
      "description": "Может управлять скидками, купонами, кодами авторов, подарками и списками использований."
    },
    "MANAGE_MARKET_SETTINGS": {
      "title": "Управление настройками маркета",
      "description": "Может управлять настройками маркета, валютами, юридическими текстами, платёжными провайдерами и их ключами, настройками доставки, вебхуками и страницей состояния."
    },
    "VIEW_MARKET_STATS": {
      "title": "Просмотр статистики маркета",
      "description": "Может просматривать страницу статистики маркета."
    }
